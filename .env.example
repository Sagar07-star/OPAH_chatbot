# CREATEchat prototype configuration.
# Copy this file to .env (or backend/.env, which takes precedence) and set
# OPENAI_API_KEY there. Loaded with python-dotenv. Never commit either file.

# --- Model (required for live AI replies) -----------------------------------
# Create a fresh key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: point at an OpenAI-compatible gateway instead of api.openai.com
# OPENAI_BASE_URL=
# OPENAI_MODERATION_MODEL=omni-moderation-latest
MODERATION_ENABLED=true
VISION_ENABLED=true
OPENAI_TIMEOUT_SECONDS=75

# --- App --------------------------------------------------------------------
APP_ENV=development
# Sessions are signed with this. A development key is generated automatically
# under backend/var/ if you leave it blank.
# APP_SECRET_KEY=
SESSION_DAYS=7

# --- Storage ----------------------------------------------------------------
# DATABASE_PATH=backend/var/createchat.db
# UPLOAD_DIR=backend/var/uploads

# --- Guardrails (configuration, not policy) ---------------------------------
MAX_UPLOAD_FILES=10
MAX_IMAGE_BYTES=8388608
MAX_PDF_BYTES=12582912
MAX_PDF_PAGES=30
MAX_PDF_TEXT_CHARS=20000
MAX_MESSAGE_CHARS=4000
MAX_TOOL_ROUNDS=6
TRANSCRIPT_LIMIT=20
TRANSCRIPT_KEEP=200
RATE_CLIENT_PER_MINUTE=20
RATE_CLIENT_PER_HOUR=200
RATE_ANON_PER_MINUTE=6
RATE_ANON_PER_HOUR=30
ANON_LIFETIME_MESSAGES=25
ANON_LIFETIME_UPLOADS=3
